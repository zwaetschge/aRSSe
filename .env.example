# ===========================================
# aRSSe - Konfigurationsdatei
# ===========================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.

# -----------------------------------------
# PostgreSQL Datenbank
# -----------------------------------------
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# -----------------------------------------
# Miniflux Admin-Benutzer
# -----------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# -----------------------------------------
# Netzwerk & Zugriff
# -----------------------------------------
# Port für Miniflux Web-Interface. Nur lokal erreichbar (hinter einem
# Reverse Proxy): MINIFLUX_PORT=127.0.0.1:8080. Der Intelligence Layer
# nutzt den Port für Links, falls BASE_URL auf localhost zeigt.
MINIFLUX_PORT=8080

# Adresse, unter der Ihre Geräte Miniflux erreichen (PWA und Links der
# Top Stories). Nicht localhost: Das wäre auf dem E-Ink-Reader das Gerät selbst.
# Beispiel: http://192.168.1.10:8080 oder https://news.meinedomain.de
# (setup.sh trägt die IP-Adresse des Servers automatisch ein)
BASE_URL=http://localhost:8080

# -----------------------------------------
# Feed-Abruf (Ingestion)
# -----------------------------------------
# Polling-Intervall in Minuten (Standard: 15)
# Niedrigere Werte = aktuellere News, aber mehr Serverlast
POLLING_FREQUENCY=15

# Aufbewahrungsdauer für gelesene Artikel (Tage)
CLEANUP_READ_DAYS=60

# Aufbewahrungsdauer für ungelesene Artikel (Tage)
CLEANUP_UNREAD_DAYS=30

# -----------------------------------------
# Intelligence Layer (Clustering + Top Stories)
# -----------------------------------------
# API-Key für Miniflux (generieren unter: Einstellungen > API-Schlüssel)
MINIFLUX_API_KEY=

# Port der Top-Stories-Oberfläche
INTELLIGENCE_PORT=8081

# Die folgenden Werte überschreiben intelligence/config.yaml.
# Auskommentiert = Wert aus config.yaml verwenden.

# Clustering-Intervall in Minuten
#CLUSTERING_INTERVAL=30

# Clustering-Schwelle (0.0-1.0): Höher = mehr Artikel in Stories, aber unschärfer
# Kalibrieren mit: docker compose exec intelligence python evaluate.py
#CLUSTERING_THRESHOLD=0.75

# Duplikat-Erkennungsschwelle (0.0-1.0): Höher = strenger
#DEDUP_THRESHOLD=0.85

# Duplikate in Miniflux als gelesen markieren: mark_read | none
#DEDUP_ACTION=mark_read

# -----------------------------------------
# System
# -----------------------------------------
# Datenpfad für persistente Speicherung (Unraid: /mnt/user/appdata/arsse)
DATA_PATH=./data

# Zeitzone
TZ=Europe/Berlin

# Benutzer/Gruppe des Intelligence-Containers (Unraid: 99/100). Der Container
# übergibt ${DATA_PATH}/intelligence beim Start selbst an diese IDs.
PUID=1000
PGID=1000

# Log-Level: DEBUG, INFO, WARNING, ERROR (leer = config.yaml)
#LOG_LEVEL=INFO
