# ===========================================
# aRSSe - Konfigurationsdatei
# ===========================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.

# -----------------------------------------
# PostgreSQL Datenbank
# -----------------------------------------
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# -----------------------------------------
# Miniflux Admin-Benutzer
# -----------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# -----------------------------------------
# Netzwerk & Zugriff
# -----------------------------------------
# Port für Miniflux Web-Interface
MINIFLUX_PORT=8080

# Basis-URL für externen Zugriff (wichtig für PWA)
# Beispiel: https://news.meinedomain.de
BASE_URL=http://localhost:8080

# -----------------------------------------
# Feed-Abruf (Ingestion)
# -----------------------------------------
# Polling-Intervall in Minuten (Standard: 15)
# Niedrigere Werte = aktuellere News, aber mehr Serverlast
POLLING_FREQUENCY=15

# Aufbewahrungsdauer für gelesene Artikel (Tage)
CLEANUP_READ_DAYS=60

# Aufbewahrungsdauer für ungelesene Artikel (Tage)
CLEANUP_UNREAD_DAYS=30

# -----------------------------------------
# Intelligence Layer (Clustering Bot)
# -----------------------------------------
# API-Key für Miniflux (generieren unter: Einstellungen > API-Schlüssel)
MINIFLUX_API_KEY=

# Clustering-Intervall in Minuten
CLUSTERING_INTERVAL=30

# DBSCAN Epsilon (0.0-1.0): Höher = weniger, aber größere Cluster
CLUSTERING_EPS=0.4

# Minimum Artikel pro Cluster
CLUSTERING_MIN_SAMPLES=2

# Duplikat-Erkennungsschwelle (0.0-1.0): Höher = strenger
DEDUP_THRESHOLD=0.85

# -----------------------------------------
# System
# -----------------------------------------
# Datenpfad für persistente Speicherung (Unraid: /mnt/user/appdata/arsse)
DATA_PATH=./data

# Zeitzone
TZ=Europe/Berlin

# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
