# ===========================================
# aRSSe - Konfigurationsdatei
# ===========================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an.

# -----------------------------------------
# PostgreSQL Datenbank
# -----------------------------------------
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# Hauptversion von PostgreSQL. Nur mit Dump und Restore ändern (README,
# "Backup und Updates"): Eine andere Version startet mit den alten
# Datendateien nicht. Ab 18 zusätzlich POSTGRES_MOUNT=/var/lib/postgresql
POSTGRES_MAJOR=15
#POSTGRES_MOUNT=/var/lib/postgresql

# -----------------------------------------
# Miniflux Admin-Benutzer
# -----------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HIER_SICHERES_PASSWORT_EINTRAGEN

# -----------------------------------------
# Netzwerk & Zugriff
# -----------------------------------------
# Port für Miniflux Web-Interface. Nur lokal erreichbar (hinter einem
# Reverse Proxy): MINIFLUX_PORT=127.0.0.1:8080. Der Intelligence Layer
# nutzt den Port für Links, falls BASE_URL auf localhost zeigt.
MINIFLUX_PORT=8080

# Adresse, unter der Ihre Geräte Miniflux erreichen (PWA und Links der
# Top Stories). Nicht localhost: Das wäre auf dem E-Ink-Reader das Gerät selbst.
# Beispiel: http://192.168.1.10:8080 oder https://news.meinedomain.de
# (setup.sh trägt die IP-Adresse des Servers automatisch ein)
BASE_URL=http://localhost:8080

# Adresse(n) Ihres Reverse Proxys (CIDR, kommagetrennt), wie Miniflux sie
# sieht. Nur von dort glaubt Miniflux X-Forwarded-Proto und markiert dann
# den Sitzungs-Cookie als "Secure". Siehe README, Abschnitt "Absicherung".
#TRUSTED_PROXIES=172.18.0.1/32

# Prometheus-Metriken von Miniflux unter /metrics (Standard: aus). Hinter
# einem Reverse Proxy nur mit Benutzername und Passwort einschalten.
#METRICS_COLLECTOR=1
#METRICS_USERNAME=prometheus
#METRICS_PASSWORD=
#METRICS_ALLOWED_NETWORKS=172.16.0.0/12

# -----------------------------------------
# Feed-Abruf (Ingestion)
# -----------------------------------------
# Polling-Intervall in Minuten (Standard: 15)
# Niedrigere Werte = aktuellere News, aber mehr Serverlast
POLLING_FREQUENCY=15

# Aufbewahrungsdauer für gelesene Artikel (Tage)
CLEANUP_READ_DAYS=60

# Aufbewahrungsdauer für ungelesene Artikel (Tage)
CLEANUP_UNREAD_DAYS=30

# -----------------------------------------
# Intelligence Layer (Clustering + Top Stories)
# -----------------------------------------
# API-Key für Miniflux (generieren unter: Einstellungen > API-Schlüssel).
# Empfohlen: der Key eines eigenen Benutzers ohne Admin-Rechte
# (README, Abschnitt "Absicherung")
MINIFLUX_API_KEY=
# Alternativ: Pfad im Container zu einer Datei mit dem Key (Docker Secret).
# Die Datei muss per docker-compose.override.yml eingebunden und für
# PUID:PGID lesbar sein (README, "Passwörter und API-Key als Datei")
#MINIFLUX_API_KEY_FILE=/run/secrets/miniflux_api_key

# Port der Top-Stories-Oberfläche. Nur lokal erreichbar (hinter einem
# Reverse Proxy): INTELLIGENCE_PORT=127.0.0.1:8081
INTELLIGENCE_PORT=8081

# Version des Intelligence-Images (ghcr.io/zwaetschge/arsse-intelligence):
# latest = letzte Release-Version, z.B. 1.0 = feste Version, edge = jeder
# Stand des Hauptzweigs. 'docker compose up -d --build' baut stattdessen
# den lokalen Code.
ARSSE_VERSION=latest

# Die folgenden Werte überschreiben die Einstellungen in
# DATA_PATH/intelligence/config.yaml (eigene Einstellungen, README
# "Konfiguration") und die Standardwerte aus intelligence/config.yaml.
# Auskommentiert = Wert aus den config.yaml-Dateien verwenden.

# Clustering-Intervall in Minuten
#CLUSTERING_INTERVAL=30

# Zeitfenster in Stunden: Artikel so alt bilden die Stories
#LOOKBACK_HOURS=24

# Stories und Artikel so viele Tage aufbewahren (mindestens so lang wie
# das Zeitfenster)
#RETENTION_DAYS=7

# Clustering-Schwelle (0.0-1.0): Höher = mehr Artikel in Stories, aber unschärfer
# Kalibrieren mit: docker compose exec intelligence python evaluate.py
#CLUSTERING_THRESHOLD=0.75

# Mindest-Ähnlichkeit einer Story aus nur zwei Artikeln (0 = aus):
# Höher = weniger zufällige Paare, aber auch weniger echte kleine Stories
#CLUSTERING_MIN_PAIR_SIMILARITY=0.30

# Längste Wortfolge im Vokabular (1 = einzelne Wörter, 2 = auch Wortpaare)
#CLUSTERING_NGRAM_MAX=1

# Themen: Stories zum selben Ereignis belegen auf der Startseite nur einen
# Platz („Mehr zum Thema“). Muss größer als CLUSTERING_THRESHOLD sein;
# kleiner = nur sehr eng verwandte Stories, 0 = aus. Ist CLUSTERING_THRESHOLD
# 0.9 oder höher und dies nicht gesetzt, bleiben die Themen aus (Warnung im Log)
#CLUSTERING_TOPIC_THRESHOLD=0.9

# Duplikat-Erkennungsschwelle (0.0-1.0): Höher = strenger
#DEDUP_THRESHOLD=0.85

# Duplikate in Miniflux als gelesen markieren: mark_read | none
#DEDUP_ACTION=mark_read

# Artikel verschiedener Feeds erst ab so vielen Wörtern Text (ohne Titel)
# als Duplikate erkennen (doppelt gelieferte Artikel mit gleicher URL und
# gleichem Titel auch darunter)
#DEDUP_MIN_BODY_TOKENS=25

# Zugriffsschutz der Top Stories: none | basic | proxy. Standard none: Wer
# den Port erreicht, sieht Ihre Abos und was Sie gelesen haben.
#WEB_AUTH_MODE=basic
# basic: Benutzername und Passwort (oder Pfad zu einer Passwortdatei im
# Container, eingebunden wie MINIFLUX_API_KEY_FILE)
#WEB_USERNAME=leser
#WEB_PASSWORD=
#WEB_PASSWORD_FILE=/run/secrets/web_password
# proxy: Der Reverse Proxy meldet an und übergibt den Benutzer in einem
# Header (nur Buchstaben, Ziffern und '-'). Geglaubt wird der Header nur von
# diesen Adressen (CIDR); nginx direkt auf dem Server: das Gateway des
# arsse-network wie bei TRUSTED_PROXIES, Port dann nur auf 127.0.0.1
#WEB_AUTH_PROXY_HEADER=Remote-User
#WEB_TRUSTED_PROXIES=172.18.0.5/32

# Nur Anfragen an diese Hostnamen beantworten (Schutz vor DNS-Rebinding),
# kommagetrennt, ohne Platzhalter (*). localhost und 127.0.0.1 gehen immer.
# Leer = jeder Hostname
#WEB_ALLOWED_HOSTS=tower.local,192.168.1.10,stories.example.com

# Stories pro Seite der Top Stories (Standard 10; kurze Seiten brauchen auf
# E-Ink-Readern kein Scrollen)
#WEB_PAGE_SIZE=10

# Nur Stories aus mindestens so vielen Feeds zeigen (Standard 2)
#WEB_MIN_SOURCES=2

# Höchstens so viele Stories über alle Seiten (Standard 100)
#WEB_MAX_STORIES=100

# -----------------------------------------
# System
# -----------------------------------------
# Datenpfad für persistente Speicherung (Unraid: /mnt/user/appdata/arsse)
DATA_PATH=./data

# Zeitzone, auch für die Uhrzeiten der Top Stories (IANA-Name wie
# Europe/Berlin oder Europe/Vienna)
TZ=Europe/Berlin

# Benutzer/Gruppe des Intelligence-Containers (Unraid: 99/100). Der Container
# übergibt ${DATA_PATH}/intelligence beim Start selbst an diese IDs.
PUID=1000
PGID=1000

# Log-Level: DEBUG, INFO, WARNING, ERROR (leer = config.yaml)
#LOG_LEVEL=INFO

# -----------------------------------------
# Backup (scripts/backup.sh)
# -----------------------------------------
# Zielverzeichnis (Standard: DATA_PATH/backups) und wie viele Tage alte
# Sicherungen behalten werden (Standard 14)
#BACKUP_DIR=/mnt/user/backups/arsse
#BACKUP_KEEP_DAYS=14
